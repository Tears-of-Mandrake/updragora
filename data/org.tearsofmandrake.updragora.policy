<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Tears of Mandrake</vendor>
  <vendor_url>https://github.com/tears-of-mandrake</vendor_url>

  <action id="org.tearsofmandrake.updragora.dnf">
    <description>Run package management operations with UPDragora</description>
    <description xml:lang="pl">Wykonywanie operacji zarządzania pakietami w UPDragora</description>
    <message>Authentication is required to manage software on this system</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby zarządzać oprogramowaniem w tym systemie</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- auth_admin_keep: password is cached for a few minutes so the
           user is not asked again for every action -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/updragora/updragora-helper</annotate>
  </action>
</policyconfig>
